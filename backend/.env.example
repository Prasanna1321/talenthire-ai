# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/talenthire_db

# --- JWT Auth ---
JWT_SECRET_KEY=change_this_to_a_long_random_secret_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google Gemini API (question generation + feedback) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- File storage ---
RESUME_UPLOAD_DIR=uploads/resumes
AUDIO_UPLOAD_DIR=uploads/audio

# --- ML model path ---
RESUME_MODEL_PATH=../ml/resume_classifier/resume_model.pkl

# --- Resend (Phase 2/3: OTP + notification emails) ---
# Get a free key at https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# --- Gemini Live API (Phase 6: real-time voice interview) ---
# No separate key needed — reuses GEMINI_API_KEY above. Free tier available.
# IMPORTANT: verify GEMINI_LIVE_MODEL (in app/config.py) against Gemini's
# current docs — Live API model names change periodically.

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
